{
  "name": "nutshell-startos",
  "scripts": {
    "build": "rm -rf ./javascript && ncc build startos/index.ts -o ./javascript",
    "prettier": "prettier --write startos tests",
    "check": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:smoke": "bash tests/smoke-nutshell.sh"
  },
  "dependencies": {
    "@start9labs/start-sdk": "2.0.9",
    "cln-startos": "github:Start9Labs/cln-startos#next"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vercel/ncc": "^0.38.4",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "trailingComma": "all",
    "tabWidth": 2,
    "semi": false,
    "singleQuote": true
  },
  "overrides": {
    "@start9labs/start-sdk": "$@start9labs/start-sdk"
  }
}
